<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!-- Vanilla Gravship Expanded (chapter 1) compat, gated by package id because textures
         and DefInjected entries cannot carry MayRequire. Mods/ holds purple copies of the
         ability and toggle icons at the main tree's paths; a later load folder wins a shared
         relative path, so it must stay below "/". -->
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="vanillaexpanded.gravship">1.6/Mods/VanillaGravshipExpanded</li>
    <!-- Combat Extended: CE's armor scale, bulk, smoke sealing and the blast's penetration
         in its units. Patches only, so it needs no art root. -->
    <li IfModActive="CETeam.CombatExtended">1.6/Mods/CombatExtended</li>
  </v1.6>
  <v1.7>
    <!-- 1.7 runs the 1.6 tree unchanged: the Waylith CLR maps every UnityEngine
         reference onto UnityStubs, so the net472 assembly loads as-is. Listed
         explicitly rather than left to the game's highest-lower-version fallback. -->
    <li>/</li>
    <li>1.6</li>
    <li IfModActive="vanillaexpanded.gravship">Mods/VanillaGravshipExpanded</li>
    <li IfModActive="vanillaexpanded.gravship">1.6/Mods/VanillaGravshipExpanded</li>
    <li IfModActive="CETeam.CombatExtended">1.6/Mods/CombatExtended</li>
  </v1.7>
</loadFolders>
