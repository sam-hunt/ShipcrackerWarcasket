<?xml version="1.0" encoding="utf-8" ?>
<!--
  Astrofuel for the Breach Jump under Vanilla Gravship Expanded.

  The armor's jump tank takes chemfuel in the main tree. VGE1 adds astrofuel
  (VGE_Astrofuel, refined 70 chemfuel to 35 at the biofuel refinery, so one unit
  is worth two chemfuel plus the work). With VGE1 active the tank takes astrofuel
  instead and a jump burns 10 charges rather than 20: the same chemfuel-equivalent
  per jump, so the refining step is never a penalty. The tank still holds 100
  units, so it carries 10 jumps.

  Astrofuel burns purple in VGE (its astrofire and fuel art), so the flight exhaust
  follows the fuel: the extension's two effecters switch from the main tree's orange
  SCWC_BreachJumpFlame / SCWC_BreachBurnFlame to this root's SCWC_BreachJumpAstroflame /
  SCWC_BreachBurnAstroflame (Defs/EffecterDefs/), which spray VGE's own Astrospark
  texture, and the armor's thruster-outlet glow (the render node in the armor def) is
  tinted the same purple as SCWC_AstroflameGlow instead of chemfuel orange. The purple
  gizmo icons need no patch: the version-independent Mods/VanillaGravshipExpanded/ root
  shadows the main tree's icon textures by path.
-->
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="SCWC_Warcasket_Shipcracker"]/comps/li[@Class="CompProperties_ApparelReloadable"]/ammoDef</xpath>
    <value>
      <ammoDef>VGE_Astrofuel</ammoDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VEF.Abilities.AbilityDef[defName="SCWC_BreachJump"]/modExtensions/li[@Class="ShipcrackerWarcasket.BreachJumpExtension"]/fuelPerJump</xpath>
    <value>
      <fuelPerJump>10</fuelPerJump>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VEF.Abilities.AbilityDef[defName="SCWC_BreachJump"]/modExtensions/li[@Class="ShipcrackerWarcasket.BreachJumpExtension"]/flightEffecter</xpath>
    <value>
      <flightEffecter>SCWC_BreachJumpAstroflame</flightEffecter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VEF.Abilities.AbilityDef[defName="SCWC_BreachJump"]/modExtensions/li[@Class="ShipcrackerWarcasket.BreachJumpExtension"]/spaceFlightEffecter</xpath>
    <value>
      <spaceFlightEffecter>SCWC_BreachBurnAstroflame</spaceFlightEffecter>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="SCWC_Warcasket_Shipcracker"]/apparel/renderNodeProperties/li[debugLabel="SCWC_ThrusterGlow"]/color</xpath>
    <value>
      <color>(0.75, 0.5, 1)</color>
    </value>
  </Operation>
</Patch>
