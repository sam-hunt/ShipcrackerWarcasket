<?xml version="1.0" encoding="utf-8" ?>
<!--
  Vanilla Gravship Expanded (chapter 1) parity for vacuum resistance.

  VGE1's 1.6/Patches/ArmorVacuumResistancePatch.xml lowers every vacuum-rated
  suit so that no armor + helmet pair reaches VacuumResistance 1.0 without an
  oxygen source (its astrorig / oxygen packs), and it covers the five VFEP
  spacer warcasket sets by an explicit defName list: armor 0.2 to 0.22, helmet
  0.7 to 0.65, shoulders left at 0.1, so a full set totals 0.97. That list never
  reaches this mod's defs, so with VGE1 active the Shipcracker set would be the
  only warcasket at a full 1.0. This patch applies the same two numbers to our
  armor and helmet (decision 2026-09-16: mirror the nerf; the shoulders stay at
  0.1 exactly as VGE1 leaves VFEP's).

  Loaded only from the IfModActive="vanillaexpanded.gravship" root in
  LoadFolders.xml (package-id gate; VGE1 hard-requires Odyssey, so the
  VacuumResistance stat always exists here). The MayRequire attribute on the
  replacement nodes is kept only to match the source defs; it is redundant
  behind this gate.
-->
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="SCWC_Warcasket_Shipcracker"]/equippedStatOffsets/VacuumResistance</xpath>
    <value>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.22</VacuumResistance>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="SCWC_WarcasketHelmet_Shipcracker"]/equippedStatOffsets/VacuumResistance</xpath>
    <value>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.65</VacuumResistance>
    </value>
  </Operation>
</Patch>
