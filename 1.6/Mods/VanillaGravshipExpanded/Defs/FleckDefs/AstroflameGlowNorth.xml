<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    North-facing variant of SCWC_AstroflameGlow (AstroflameGlow.xml): inherits everything from
    the parent and only raises the altitude to the Pawn layer, +5 sub-layers, so the glow
    draws over the wearer instead of under when flying north and the mid-back thruster
    outlets face the camera (see the main tree's JumpFlameNorth.xml for the layering
    rationale). Sprayed via fleckDefNorth by ShipcrackerWarcasket.SubEffecter_ExhaustSprayer
    while the flying wearer faces north (2026-09-18).
  -->
  <FleckDef ParentName="SCWC_AstroflameGlow">
    <defName>SCWC_AstroflameGlowNorth</defName>
    <altitudeLayer>Pawn</altitudeLayer>
    <altitudeLayerIncOffset>5</altitudeLayerIncOffset>
  </FleckDef>
</Defs>
