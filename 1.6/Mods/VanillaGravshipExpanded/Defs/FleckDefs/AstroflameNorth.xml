<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    SCWC_Astroflame raised to PawnState so the purple exhaust draws over the wearer's back
    while they fly facing north; sprayed as fleckDefNorth by SubEffecter_ExhaustSprayer. See
    the main tree's JumpFlameNorth.xml for the layer choice.
  -->
  <FleckDef ParentName="SCWC_Astroflame">
    <defName>SCWC_AstroflameNorth</defName>
    <altitudeLayer>PawnState</altitudeLayer>
  </FleckDef>
</Defs>
