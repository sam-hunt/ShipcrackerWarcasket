<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Templated from VFEP's VFEP_WarcasketShoulders_Siegebreaker (VFEPirates.WarcasketDef,
    ParentName="VFEP_WarcasketShoulderPadBase") at VFEP commit e237aba (2026-08-29),
    1.6/Defs/ThingDefs_Misc/Apparel_Various.xml. Everything not listed under
    "Tuning" below is still a verbatim Siegebreaker copy (placeholder, per
    TODOs.md). See Warcasket_Shipcracker.xml's header for the Odyssey patch
    findings and the WarcasketVeteran/WarcasketAll tag research; the same
    conclusion applies here.

    Tuning (2026-09-13): costList Plasteel 70 (Siegebreaker 60). Follows the
    armor's Plasteel rise to 165 at the shoulder-to-armor ratio the 10th-gen
    sets use, roughly 0.4 (Siegebreaker 60/145, Guardian 80/200, Controller
    60/150, Sarcophagus 60/145, Brute 60/160): 0.4 x 165 = 66, rounded up to
    the 10-plasteel steps VFEP's costLists use. No spacer components, like the
    Siegebreaker, Guardian and Sarcophagus shoulders.

    SOS2/Universum: our 1.6/Patches/SOS2Patch.xml deliberately leaves shoulder
    pads alone, mirroring VFEP's own patch, which only touches armor and helmets.
    Art: Things/Pawn/Warcasketlike/WarcasketShipcracker/WarcasketShipcrackerShoulders
    (+ _north/_east/_south), 256x256 RGBA under the root Textures/ folder, mirroring
    VFEP's own warcasket layout.
  -->
  <VFEPirates.WarcasketDef ParentName="VFEP_WarcasketShoulderPadBase">
    <defName>SCWC_WarcasketShoulders_Shipcracker</defName>
    <label>shipcracker warcasket shoulders</label>
    <shortDescription>Placeholder shipcracker warcasket pauldrons. Stats are an untuned copy of the siegebreaker warcasket shoulders for now.</shortDescription>
    <description>Placeholder description for the shipcracker warcasket pauldrons. It is a stand-in for later tuning, not lore.</description>
    <graphicData>
      <texPath>Things/Pawn/Warcasketlike/WarcasketShipcracker/WarcasketShipcrackerShoulders</texPath>
    </graphicData>
    <statBases>
      <Mass>20</Mass>
      <ArmorRating_Sharp>2</ArmorRating_Sharp>
      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <Insulation_Cold>22</Insulation_Cold>
      <Insulation_Heat>22</Insulation_Heat>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.2</SlaveSuppressionOffset>
      <EnergyShieldRechargeRate>1</EnergyShieldRechargeRate>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.1</VacuumResistance>
    </equippedStatOffsets>
    <costList>
      <Plasteel>70</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>VFEP_SpacerWarcaskets</li>
    </researchPrerequisites>
    <apparel>
      <bodyPartGroups>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Neck</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Warcasketlike/WarcasketShipcracker/WarcasketShipcrackerShoulders</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <!-- Reusing WarcasketVeteran puts this set on every Junker/Mercenary
             veteran-tier pawnkind (and Odyssey's salvager pawnkind); see
             TODOs.md open question.
        <li>WarcasketVeteran</li>
        -->
        <li>WarcasketAll</li>
      </tags>
    </apparel>
  </VFEPirates.WarcasketDef>
</Defs>
