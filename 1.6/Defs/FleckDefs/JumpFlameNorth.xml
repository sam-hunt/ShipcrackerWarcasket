<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    VFEP's VFEP_JumpFlame raised to PawnState (the layer vanilla uses for motes held over a
    pawn) so the exhaust draws over the wearer's back while they fly facing north; a fleck's
    altitude comes only from its def, so a separate def is needed. Sprayed as fleckDefNorth by
    SubEffecter_ExhaustSprayer. A full copy because VFEP's def has no Name attribute to inherit
    from; keep in step with it.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpFlameNorth</defName>
    <graphicData>
      <texPath>Things/Mote/VFEP_JumpFlame</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <growthRate>-4</growthRate>
  </FleckDef>
</Defs>
