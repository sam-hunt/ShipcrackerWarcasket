<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Copy of VFEP's VFEP_JumpFlame (Fleck_Visual.xml) with only the altitude changed: Pawn
    layer, +5 sub-layers, instead of Projectile. Flying north puts the wearer's thruster
    outlets (mid-back) toward the camera, so the exhaust trail needs to draw over the wearer
    instead of under; a fleck's altitude is fixed by its def, so this is a second fleck rather
    than a runtime override. +5 clears the render tree and the flyer's own draw offset above
    the Pawn layer with margin, while staying under Blueprint (2026-09-18). VFEP's def carries
    no Name attribute, so it cannot be a ParentName here; every other field is copied by hand.
    Sprayed via fleckDefNorth by ShipcrackerWarcasket.SubEffecter_ExhaustSprayer while the
    flying wearer faces north. Keep in step with VFEP's VFEP_JumpFlame.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpFlameNorth</defName>
    <graphicData>
      <texPath>Things/Mote/VFEP_JumpFlame</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>Pawn</altitudeLayer>
    <altitudeLayerIncOffset>5</altitudeLayerIncOffset>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <growthRate>-4</growthRate>
  </FleckDef>
</Defs>
