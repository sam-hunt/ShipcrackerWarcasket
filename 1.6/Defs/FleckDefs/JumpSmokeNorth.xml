<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    VFEP's VFEP_JumpSmoke raised to PawnState (the layer vanilla uses for motes held over a
    pawn) so the exhaust draws over the wearer's back while they fly facing north; a fleck's
    altitude comes only from its def, so a separate def is needed. Sprayed as fleckDefNorth by
    SubEffecter_ExhaustSprayer. A full copy because VFEP's def has no Name attribute to inherit
    from; keep in step with it. Also used by the Vanilla Gravship Expanded root's purple
    effecters, which have no smoke fleck of their own.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpSmokeNorth</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
    <growthRate>1.2</growthRate>
  </FleckDef>
</Defs>
