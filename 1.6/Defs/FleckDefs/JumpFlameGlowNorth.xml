<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Copy of VFEP's VFEP_JumpFlameGlow (Fleck_Visual.xml) with only the altitude changed:
    PawnState, the layer vanilla gives motes held over a pawn, instead of Projectile. Flying north
    puts the wearer's thruster outlets (mid-back) toward the camera, so the exhaust trail should
    draw over the wearer instead of under; a fleck's altitude is fixed by its def, so this is a
    second fleck rather than a runtime override. Pawn plus five increments was tried first and
    still drew under the wearer in game although it sat above the render tree by every number
    the game reports; PawnState draws over (2026-09-18, see SubEffecter_ExhaustSprayer).
    VFEP's def carries no Name attribute, so it cannot be a ParentName here; every other field
    is copied by hand. Sprayed via fleckDefNorth by ShipcrackerWarcasket.SubEffecter_ExhaustSprayer
    while the flying wearer faces north. Keep in step with VFEP's VFEP_JumpFlameGlow.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpFlameGlowNorth</defName>
    <graphicData>
      <texPath>Things/Mote/VFEP_JumpFlame</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1,0.6,0.6,0.3)</color>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <growthRate>-3</growthRate>
  </FleckDef>
</Defs>
