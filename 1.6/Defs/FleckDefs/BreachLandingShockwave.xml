<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    The shockwave ring a Breach Jump or Breach Burn leaves where it lands, on a planet and in
    space alike, fired by SCWC_BreachLanding as the SCWC_Breach explosion's centre effecter.
    The launch ring's big sibling: same Core impact-wave recipe (see
    BreachJumpShockwave.xml for the shader, the textures, the sizing formula and why this
    replaced the psycast-style disc on 2026-09-18), sized to the landing blast rather than
    the thrusters. The ring has to clear the breach footprint (breachRadius 2 on the ability
    extension, a 5-cell-wide disc) so it reads as the impact spreading past the rubble, not
    lost under it: drawSize 4.5 over 0.40 s at growthRate 1.5 ends at 7.2 cells across
    (launch 3.6). Timings follow Biotech's mech-band shockwave shape (fade in 0.04, hold,
    fade out 0.10) at less than half its life. _distortionIntensity 0.066 is the mech-band
    value, the one physical stun shockwave in the game and a harder hit than the launch's
    0.05. MoteOverheadLow draws it over the wearer and whoever else stands in the blast,
    while the Bomb-style cell flecks on MoteOverhead, one layer up, still burst over it. If
    breachRadius changes, rescale drawSize with it.
  -->
  <FleckDef ParentName="FleckBase">
    <defName>SCWC_BreachLandingShockwave</defName>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.26</solidTime>
    <fadeOutTime>0.10</fadeOutTime>
    <growthRate>1.5</growthRate>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>MoteLargeDistortionWave</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.066</_distortionIntensity>
        <_brightnessMultiplier>1.15</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>4.5</drawSize>
    </graphicData>
  </FleckDef>
</Defs>
