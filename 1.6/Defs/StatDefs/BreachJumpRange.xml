<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Pawn-level planet-side range read by Ability_BreachJump, so any worn piece can add to it
    through equippedStatOffsets (templated from VFEP's VFEP_PowerJumpRange). Base 0: no armor,
    no jump. Only the armor contributes (+20); Patches/AerialJumpRange.xml lets VFEP's Aerial
    shoulders and helmet add theirs. Left visible on the stat sheet (VFEP hides its copies).
    The description names neither gravity nor vacuum: the stat sheet has no runtime gate, so
    the text must read right without Odyssey, and the ability tooltip already carries the
    vacuum rule where it is acted on. cacheable because the gizmo, range ring and hit test
    read it every frame.
  -->
  <StatDef>
    <defName>SCWC_BreachJumpRange</defName>
    <label>breach jump range</label>
    <description>The maximum distance of a breach jump.</description>
    <category>BasicsPawn</category>
    <toStringStyle>FloatOne</toStringStyle>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <showIfUndefined>false</showIfUndefined>
    <cacheable>true</cacheable>
    <displayPriorityInCategory>1010</displayPriorityInCategory>
  </StatDef>
</Defs>
