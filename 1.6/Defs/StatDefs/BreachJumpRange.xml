<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Pawn-level stat read by Ability_BreachJump for the planet-side range, so any worn piece can
    add to it through equippedStatOffsets (VFEP's Aerial model with VFEP_PowerJumpRange, which
    this is templated from). Base 0: no armor, no jump. Contributions: armor +20. The shoulders
    and helmet add none, so the set's whole range sits on the piece that carries the thrusters;
    Aerial's full set reaches 40. Left visible on the pawn's stat sheet (VFEP hides its copies).
    The description says nothing about space: the stat sheet has no runtime gate like the
    ability tooltip's, and a player without Odyssey should not read about the breach burn;
    "under gravity" is the only hint, and the ability tooltip carries the vacuum rule where it
    applies. cacheable lets Ability_BreachJump read it through StatWorker's per-pawn cache with a
    stale window, since the gizmo, range ring and hit test all read it every frame.
  -->
  <StatDef>
    <defName>SCWC_BreachJumpRange</defName>
    <label>breach jump range</label>
    <description>The maximum distance of a breach jump under gravity.</description>
    <category>BasicsPawn</category>
    <toStringStyle>FloatOne</toStringStyle>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <showIfUndefined>false</showIfUndefined>
    <cacheable>true</cacheable>
    <displayPriorityInCategory>1010</displayPriorityInCategory>
  </StatDef>
</Defs>
