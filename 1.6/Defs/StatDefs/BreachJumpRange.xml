<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Pawn-level stat read by Ability_BreachJump for the planet-side range, so any
    worn piece can add to it through equippedStatOffsets (VFEP's Aerial model with
    VFEP_PowerJumpRange, which this is templated from). Base 0: no armor, no jump.
    Contributions (2026-09-16): armor +20. The shoulders and helmet add none, so the
    set's whole range sits on the piece that carries the thrusters; Aerial's full
    set reaches 40. Left visible on the pawn's stat sheet (VFEP hides its copies).
  -->
  <StatDef>
    <defName>SCWC_BreachJumpRange</defName>
    <label>breach jump range</label>
    <description>The maximum distance of a breach jump on a planet. In space the jump has no range limit and needs only a clear line of sight.</description>
    <category>BasicsPawn</category>
    <toStringStyle>FloatOne</toStringStyle>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <showIfUndefined>false</showIfUndefined>
    <displayPriorityInCategory>1010</displayPriorityInCategory>
  </StatDef>
</Defs>
