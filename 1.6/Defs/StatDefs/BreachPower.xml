<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Pawn-level multiplier on a Breach Jump landing's structural damage, read by
    DamageWorker_Breach for buildings only. Base 1; the shoulders add 0.5 (900 to a wall cell,
    225 to passable buildings). Base numbers in DamageDefs/Breach.xml.
  -->
  <StatDef>
    <defName>SCWC_BreachPower</defName>
    <label>breach power</label>
    <description>A multiplier on the damage a breach jump landing deals to walls and other structures. Creatures and mechanoids take no extra damage.</description>
    <category>BasicsPawn</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>1</hideAtValue>
    <showIfUndefined>false</showIfUndefined>
    <displayPriorityInCategory>1011</displayPriorityInCategory>
  </StatDef>
</Defs>
