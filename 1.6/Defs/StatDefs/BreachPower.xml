<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Pawn-level multiplier on the Breach Jump's landing damage (Ability_BreachJump
    .DoBreach). Base 1. Contributions (2026-09-16): shoulders +0.5, so with them on a
    landing deals 45 to pawns and 900 to structures, enough for plasteel (840) and
    uranium (750) walls; see BreachJump.xml for the base numbers.
  -->
  <StatDef>
    <defName>SCWC_BreachPower</defName>
    <label>breach power</label>
    <description>A multiplier on the damage a breach jump landing deals.</description>
    <category>BasicsPawn</category>
    <toStringStyle>PercentZero</toStringStyle>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <hideAtValue>1</hideAtValue>
    <showIfUndefined>false</showIfUndefined>
    <displayPriorityInCategory>1011</displayPriorityInCategory>
  </StatDef>
</Defs>
