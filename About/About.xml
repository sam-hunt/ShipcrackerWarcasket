<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Shipcracker Warcasket</name>
  <author>Sam Hunt</author>
  <!-- Lowercase by convention: MayRequire/ModsConfig matching is case-exact-lowercase. -->
  <packageId>shunter.shipcrackerwarcasket</packageId>
  <modVersion>0.1.0</modVersion>
  <description>Adds the Shipcracker, a new warcasket set for Vanilla Factions Expanded - Pirates built for the late game. Armor, shoulder pads and helmet, made at the warcasket foundry like any other set. Tuned for Odyssey's end-game threats; Odyssey is not required, and Odyssey-specific content simply does not load without it. Requires Vanilla Factions Expanded - Pirates.</description>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <!-- VFE Pirates hard-requires Vanilla Expanded Framework itself, so it is not
         re-declared here; it is listed in loadAfter so ordering stays explicit. -->
    <li>
      <packageId>OskarPotocki.VFE.Pirates</packageId>
      <displayName>Vanilla Factions Expanded - Pirates</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2723801948</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>ludeon.rimworld</li>
    <li>ludeon.rimworld.royalty</li>
    <li>ludeon.rimworld.ideology</li>
    <li>ludeon.rimworld.biotech</li>
    <li>ludeon.rimworld.anomaly</li>
    <li>ludeon.rimworld.odyssey</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>OskarPotocki.VFE.Pirates</li>
  </loadAfter>
</ModMetaData>
